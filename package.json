{
  "name": "teptris",
  "version": "0.3.10",
  "description": "TOML for JavaScript/TypeScript at libteptris speed (WebAssembly, no fallback) - version tracks the engine ({engine}.{iteration}; npm semver is 3-part)",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "./build.sh",
    "test": "node --test test/test.mjs test/package.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leptris/teptris-ts.git"
  },
  "engines": {
    "node": ">=20"
  },
  "types": "src/index.d.ts",
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "smol-toml": "^1.9.1"
  }
}
